{
  "openapi": "3.1.0",
  "info": {
    "title": "SuperH3 Video API",
    "version": "2.4.0",
    "description": "Public SuperH3 video and optional H3 Ref2VA prompt-Agent API. Consumption currency=CREDITS, unit=microcredits; 1 credit=1000000 microcredits. Recharge CNY 1=1 credit; USD conversion is billing.credits_per_usd_micros/1000000 in GET /config. Refresh live config, catalog and the formal quote before every new paid operation. Legacy microyuan fields are identical integer aliases, not another currency. Prompt assistance is off by default and requires separate explicit paid consent. Ref2VA reference generation only; read live capabilities and owned task receipts."
  },
  "servers": [
    {
      "url": "https://superh3.com/api/v1"
    }
  ],
  "security": [
    {
      "personalKey": []
    }
  ],
  "components": {
    "securitySchemes": {
      "personalKey": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "PromptAssistRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "prompt",
          "images",
          "seconds",
          "aspect",
          "idempotency_key",
          "configuration_version",
          "accepted_price",
          "user_authorized"
        ],
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 7000
          },
          "images": {
            "type": "array",
            "maxItems": 9,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "1–9 owned reference images. Use each id returned by POST /uploads/image in the user’s binding order.",
            "minItems": 1
          },
          "seconds": {
            "type": "integer",
            "minimum": 4,
            "maximum": 15,
            "description": "User's selected output duration"
          },
          "aspect": {
            "type": "string",
            "description": "Use current generation_constraints.aspects from GET /config"
          },
          "idempotency_key": {
            "type": "string",
            "format": "uuid",
            "description": "Persist before submission; same UUID and parameters for network retries"
          },
          "configuration_version": {
            "type": "string",
            "description": "generation_constraints.version from GET /config"
          },
          "accepted_price": {
            "type": "integer",
            "const": 30000,
            "description": "Confirmed microcredits; current 0.03 credits per request"
          },
          "user_authorized": {
            "type": "boolean",
            "const": true,
            "description": "Required explicit user authorization for paid assistance. Omission/false is rejected. Default behavior is not enabled; video authorization does not imply this consent."
          }
        }
      },
      "PromptAssistReceipt": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "model": {
            "type": "string",
            "const": "H3 Ref2VA 提示词助手"
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "completed",
              "failed"
            ]
          },
          "text": {
            "type": "string"
          },
          "cost": {
            "type": "integer",
            "description": "Locked original price in microcredits"
          },
          "charged": {
            "type": "boolean"
          },
          "error_code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "progress": {
            "type": "object",
            "properties": {
              "phase": {
                "type": "string",
                "enum": [
                  "preparing",
                  "submitting",
                  "waiting",
                  "writing",
                  "receiving",
                  "checking",
                  "processing"
                ]
              },
              "percent": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 100,
                "description": "Measured current-stage percentage; null if unknown. Never completion or ETA."
              },
              "observed_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "CreditBilling": {
        "type": "object",
        "properties": {
          "currency": {
            "type": "string",
            "const": "CREDITS"
          },
          "unit": {
            "type": "string",
            "const": "microcredits"
          },
          "microcredits_per_credit": {
            "type": "integer",
            "const": 1000000
          },
          "credits_per_cny": {
            "type": "integer",
            "const": 1
          },
          "credits_per_usd_micros": {
            "type": "integer",
            "example": 6700000,
            "description": "Live recharge ratio multiplied by 1000000. 6700000 means USD 1 buys 6.7 credits. Not the unit of consumption prices."
          }
        }
      }
    }
  },
  "paths": {
    "/catalog": {
      "get": {
        "summary": "Public live tier prices; rates are microcredits per output second",
        "operationId": "get_catalog",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "API error; do not create replacement tasks on ambiguous submission",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "retry_after": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": []
      }
    },
    "/config": {
      "get": {
        "summary": "Public current capability flags; true does not guarantee available capacity",
        "operationId": "get_config",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "billing": {
                      "$ref": "#/components/schemas/CreditBilling"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "API error; do not create replacement tasks on ambiguous submission",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "retry_after": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": [],
        "description": "Refresh before new paid operations. A previously cached guide does not automatically change. Current billing, capability and payment settings take precedence; obtain the formal quote and explicit user consent."
      }
    },
    "/me": {
      "get": {
        "summary": "Account, available/held microcredits, tier and concurrency",
        "operationId": "get_me",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "default": {
            "description": "API error; do not create replacement tasks on ambiguous submission",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "retry_after": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/quotes/estimate": {
      "post": {
        "summary": "Real account price preview; no consent, quote token, hold or task",
        "operationId": "post_quotes_estimate",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "cost",
                    "currency",
                    "card_uses",
                    "generation_mode"
                  ],
                  "properties": {
                    "cost": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Integer microcredits; 1 credit = 1000000 microcredits"
                    },
                    "currency": {
                      "type": "string",
                      "enum": [
                        "CREDITS"
                      ]
                    },
                    "card_uses": {
                      "type": "integer",
                      "enum": [
                        0,
                        1
                      ]
                    },
                    "generation_mode": {
                      "type": "string",
                      "enum": [
                        "live",
                        "simulation",
                        "mixed",
                        "unavailable"
                      ]
                    },
                    "quote_token": {
                      "type": "string",
                      "description": "Formal quote only; never returned by /quotes/estimate"
                    },
                    "estimate_only": {
                      "type": "boolean"
                    },
                    "allocations": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "unit": {
                      "type": "string",
                      "enum": [
                        "microcredits"
                      ]
                    },
                    "microcredits_per_credit": {
                      "type": "integer",
                      "const": 1000000
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "API error; do not create replacement tasks on ambiguous submission",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "retry_after": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "mode",
                  "resolution",
                  "seconds"
                ],
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": [
                      "reference"
                    ],
                    "description": "Ref2VA only. One image is still a reference, not a fixed first frame (I2VA)."
                  },
                  "resolution": {
                    "type": "string",
                    "enum": [
                      "768",
                      "1080"
                    ],
                    "description": "Supported output quality. 2K is unavailable."
                  },
                  "seconds": {
                    "type": "integer",
                    "minimum": 4,
                    "maximum": 15,
                    "multipleOf": 1
                  },
                  "card_id": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/quotes": {
      "post": {
        "summary": "Formal quote after consent; still no hold or task",
        "operationId": "post_quotes",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "cost",
                    "currency",
                    "card_uses",
                    "generation_mode"
                  ],
                  "properties": {
                    "cost": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Integer microcredits; 1 credit = 1000000 microcredits"
                    },
                    "currency": {
                      "type": "string",
                      "enum": [
                        "CREDITS"
                      ]
                    },
                    "card_uses": {
                      "type": "integer",
                      "enum": [
                        0,
                        1
                      ]
                    },
                    "generation_mode": {
                      "type": "string",
                      "enum": [
                        "live",
                        "simulation",
                        "mixed",
                        "unavailable"
                      ]
                    },
                    "quote_token": {
                      "type": "string",
                      "description": "Formal quote only; never returned by /quotes/estimate"
                    },
                    "estimate_only": {
                      "type": "boolean"
                    },
                    "allocations": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    },
                    "unit": {
                      "type": "string",
                      "enum": [
                        "microcredits"
                      ]
                    },
                    "microcredits_per_credit": {
                      "type": "integer",
                      "const": 1000000
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "API error; do not create replacement tasks on ambiguous submission",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "retry_after": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": [
                      "reference"
                    ],
                    "description": "Ref2VA only. One image is still a reference, not a fixed first frame (I2VA)."
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 7000
                  },
                  "resolution": {
                    "type": "string",
                    "enum": [
                      "768",
                      "1080"
                    ],
                    "description": "Supported output quality. 2K is unavailable."
                  },
                  "seconds": {
                    "type": "integer",
                    "minimum": 4,
                    "maximum": 15,
                    "multipleOf": 1
                  },
                  "aspect": {
                    "type": "string",
                    "enum": [
                      "16:9",
                      "9:16",
                      "1:1",
                      "4:3",
                      "3:4",
                      "21:9"
                    ]
                  },
                  "references": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "maxItems": 12,
                    "minItems": 1
                  },
                  "project_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "card_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "accepted_policy": {
                    "type": "boolean",
                    "const": true
                  },
                  "idempotency_key": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "quote_token": {
                    "type": "string"
                  }
                },
                "required": [
                  "mode",
                  "prompt",
                  "resolution",
                  "seconds",
                  "aspect",
                  "accepted_policy",
                  "references"
                ]
              }
            }
          }
        }
      }
    },
    "/generations": {
      "post": {
        "summary": "Paid submission; freezes quoted funds, settles on confirmed success; persist UUID before request",
        "operationId": "post_generations",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "format": "uuid"
                          },
                          "state": {
                            "type": "string",
                            "enum": [
                              "queued",
                              "preparing",
                              "submit_intent",
                              "processing",
                              "submission_unknown",
                              "completed",
                              "failed",
                              "cancelled"
                            ]
                          },
                          "cost": {
                            "type": "integer"
                          },
                          "result_asset_id": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "result_available": {
                            "type": "boolean"
                          },
                          "local_test": {
                            "type": "boolean"
                          },
                          "error_code": {
                            "type": [
                              "string",
                              "null"
                            ]
                          },
                          "created_at": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "date-time"
                          },
                          "first_prepare_at": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "date-time"
                          },
                          "intent_at": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "date-time"
                          },
                          "started_at": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "date-time"
                          },
                          "finished_at": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "date-time"
                          },
                          "result_expires_at": {
                            "type": [
                              "string",
                              "null"
                            ],
                            "format": "date-time"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "API error; do not create replacement tasks on ambiguous submission",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        },
                        "retry_after": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,

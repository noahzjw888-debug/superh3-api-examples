                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/assets/{id}/file": {
      "get": {
        "summary": "Authenticated result download; result may expire; redirects must not receive Bearer key",
        "operationId": "get_assets_id_file",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "video/mp4": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "default": {
            "description": "API error; do not create replacement tasks on ambiguous submission",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",

            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "mode": {
                    "type": "string",
                    "enum": [
                      "reference"
                    ],
                    "description": "Ref2VA only. One image is still a reference, not a fixed first frame (I2VA)."
                  },
                  "prompt": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 7000
                  },
                  "resolution": {
                    "type": "string",
                    "enum": [
                      "768",
                      "1080"
                    ],
                    "description": "Supported output quality. 2K is unavailable."
                  },
                  "seconds": {
                    "type": "integer",
                    "minimum": 4,
                    "maximum": 15,
                    "multipleOf": 1
                  },
                  "aspect": {
                    "type": "string",
                    "enum": [
                      "16:9",
                      "9:16",
                      "1:1",
                      "4:3",
                      "3:4",
                      "21:9"
                    ]
                  },
                  "references": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "uuid"
                    },
                    "maxItems": 12,
                    "minItems": 1
                  },
                  "project_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "card_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "accepted_policy": {
                    "type": "boolean",
                    "const": true
                  },
                  "idempotency_key": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "quote_token": {
                    "type": "string"
                  }
                },
                "required": [
                  "mode",
                  "prompt",
                  "resolution",
                  "seconds",
                  "aspect",
                  "accepted_policy",
                  "idempotency_key",
                  "quote_token",
                  "references"
                ]
              }
